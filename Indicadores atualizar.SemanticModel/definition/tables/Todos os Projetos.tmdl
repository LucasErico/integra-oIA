	partition 'Todos os Projetos' = calculated
		mode: import
		source =
				
				
				UNION(
				
				    SELECTCOLUMNS(
				
				        'Edital Inova 2023',
				
				        "Departamento Regional", 'Edital Inova 2023'[Departamento Regional],
				
				        "Estado", 'Edital Inova 2023'[Estado sem acento],
				
				        "Núcleo", 'Edital Inova 2023'[Núcleo],
				
				        "Responsável", 'Edital Inova 2023'[Responsável pelo projeto],
				
				        "Email", 'Edital Inova 2023'[Email do responsável pelo projeto],
				
				        "Nome do Projeto", 'Edital Inova 2023'[Nome do projeto],
				
				        "Edital", "Inova 2023",
				
				        "Ano", 2023,
				
				        "Tipo Edital", "Inova"
				
				    ),
				
				    SELECTCOLUMNS(
				
				        'Edital Inova 2024',
				
				        "Departamento Regional", 'Edital Inova 2024'[Departamento Regional],
				
				        "Estado", 'Edital Inova 2024'[Estado sem acento],
				
				        "Núcleo", 'Edital Inova 2024'[Núcleo],
				
				        "Responsável", 'Edital Inova 2024'[Responsável pelo projeto],
				
				        "Email", 'Edital Inova 2024'[Email do responsável pelo projeto],
				
				        "Nome do Projeto", 'Edital Inova 2024'[Nome do projeto],
				
				        "Edital", "Inova 2024",
				
				        "Ano", 2024,
				
				        "Tipo Edital", "Inova"
				
				    ),
				
				    SELECTCOLUMNS(
				
				        'Edital Melhores Práticas 2024',
				
				        "Departamento Regional", 'Edital Melhores Práticas 2024'[Departamento Regional],
				
				        "Estado", 'Edital Melhores Práticas 2024'[Estado sem acento],
				
				        "Núcleo", 'Edital Melhores Práticas 2024'[Núcleo],
				
				        "Responsável", 'Edital Melhores Práticas 2024'[Responsável pelo projeto],
				
				        "Email", 'Edital Melhores Práticas 2024'[Email do responsável pelo projeto],
				
				        "Nome do Projeto", 'Edital Melhores Práticas 2024'[Nome do projeto],
				
				        "Edital", "Melhores Práticas 2024",
				
				        "Ano", 2024,
				
				        "Tipo Edital", "Melhores Práticas"
				
				    ),
				
				    SELECTCOLUMNS(
				
				        'Edital Melhores Práticas 2025',
				
				        "Departamento Regional", 'Edital Melhores Práticas 2025'[Departamento Regional],
				
				        "Estado", 'Edital Melhores Práticas 2025'[Estado sem acento],
				
				        "Núcleo", 'Edital Melhores Práticas 2025'[Núcleo],
				
				        "Responsável", 'Edital Melhores Práticas 2025'[Responsável pelo projeto],
				
				        "Email", 'Edital Melhores Práticas 2025'[Email do responsável pelo projeto],
				
				        "Nome do Projeto", 'Edital Melhores Práticas 2025'[Nome do projeto],
				
				        "Edital", "Melhores Práticas 2025",
				
				        "Ano", 2025,
				
				        "Tipo Edital", "Melhores Práticas"
				
				    )
				
				)

	annotation PBI_Id = 3319efdbb9ef4227b43177d893ade51d

