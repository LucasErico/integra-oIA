table 'Todos os Projetos'
	lineageTag: 27849a7c-ff70-4b1c-bcea-6e783dce5bf2

	measure 'Total Sem Filtros' = CALCULATE(COUNTROWS('Todos os Projetos'), ALLSELECTED('Todos os Projetos'))
		formatString: 0
		lineageTag: e6149740-cb75-4114-bdbf-409ce73253aa

	measure 'Total Força Bruta' = ```
			
			VAR TabelaResumo = 
			    SUMMARIZE(
			        'Todos os Projetos', 
			        'Todos os Projetos'[Departamento Regional], 
			        'Todos os Projetos'[Edital],
			        "Contagem", COUNTROWS('Todos os Projetos')
			    )
			RETURN
			    SUMX(TabelaResumo, [Contagem])
			```
		formatString: 0
		lineageTag: f8c7eedd-753a-4a56-82cb-b54106fc8a76

